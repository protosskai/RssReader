  {
    "name": "Reading Progress — Scroll Tracking and Auto Mark-Read",
    "methods": ["state_transition", "boundary", "positive"],
    "description": "Reading store state machine: startReading('article-1', 1500 words) → verify isReading=true, estimatedReadingTime=360s (ceil(1500/250*60)) → updateProgress to 0.5 (50%) → verify progress=50, markedAsRead=false → updateProgress to 0.9 (90%) → verify progress=90, markedAsRead=true (auto-crossed threshold 0.8) → stopReading → verify isReading=false → startReading for a second article concurrently → verify currentArticleId switches → getProgress for first article preserved in Map → clearProgress('article-1') → getProgress returns undefined. Tests estimateReadingTime with edge case wordCounts: 0, 1, 250, 999999.",
    "testFilePath": "test/e2e/reading-progress.test.ts",
    "fixtures": {
      "articles": [
        { "articleId": "article-001", "wordCount": 1500, "expectedMinutes": 6, "expectedSeconds": 360 },
        { "articleId": "article-002", "wordCount": 250, "expectedMinutes": 1, "expectedSeconds": 60 },
        { "articleId": "article-003", "wordCount": 0, "expectedSeconds": 0 },
        { "articleId": "article-004", "wordCount": 999999, "expectedSeconds": 240000 }
      ]
    },
    "assertions": [
      { "type": "boolean", "expected": true, "description": "isReading is true after startReading" },
      { "type": "count", "expected": 360, "description": "estimatedReadingTime for 1500 words at 250 wpm is 360s" },
      { "type": "count", "expected": 50, "description": "updateProgress to scroll 0.5 sets progress=50" },
      { "type": "boolean", "expected": false, "description": "markedAsRead is false at 50% scroll" },
      { "type": "count", "expected": 90, "description": "updateProgress to scroll 0.9 sets progress=90" },
      { "type": "boolean", "expected": true, "description": "markedAsRead becomes true when scroll >= 0.8" },
      { "type": "boolean", "expected": false, "description": "isReading is false after stopReading" },
      { "type": "text", "expected": "article-002", "description": "currentArticleId updates when reading new article" },
      { "type": "count", "expected": 60, "description": "estimateReadingTime(250) returns 60s" },
      { "type": "count", "expected": 0, "description": "estimateReadingTime(0) returns 0s" }
    ]
  },
  {
    "name": "Sync Progress — Batch Sync with Partial Failures",
    "methods": ["positive", "exception", "state_transition", "boundary"],
    "description": "SyncManager end-to-end flow via syncProgressStore: start syncAll of 3 sources → verify progress.isSyncing=true, totalSources=3, each source transitions pending→syncing→success/failed → one source fails (mock network error) → verify failureCount=1, successCount=2, completedCount=3 → progressPercent = round(3/3 * 100) = 100 → startPolling/stopPolling: verify isPolling flag transitions correctly → sync with 0 sources (boundary) → verify progressPercent returns 0. Tests the batch batching logic (5 concurrency) and progress state machine without real network.",
    "testFilePath": "test/e2e/sync-progress.test.ts",
    "fixtures": {
      "sources": [
        { "rss_id": "sync-001", "title": "Hacker News", "status": "pending" },
        { "rss_id": "sync-002", "title": "BBC World", "status": "pending" },
        { "rss_id": "sync-003", "title": "Slow Feed", "status": "pending" }
      ],
      "syncConfig": { "enabled": true, "interval": 30, "backgroundSync": true, "syncOnStartup": true, "notification": true },
      "mockSyncResults": { "success": ["sync-001", "sync-002"], "failure": ["sync-003"] }
    },
    "assertions": [
      { "type": "boolean", "expected": true, "description": "progress.isSyncing is true during sync" },
      { "type": "count", "expected": 3, "description": "totalSources is 3" },
      { "type": "count", "expected": 2, "description": "successCount is 2 after sync" },
      { "type": "count", "expected": 1, "description": "failureCount is 1 (Slow Feed fails)" },
      { "type": "count", "expected": 3, "description": "completedCount equals totalSources after all batches" },
      { "type": "count", "expected": 100, "description": "progressPercent = 100 when completed=total" },
      { "type": "text", "expected": "syncing", "description": "Current source starts in 'syncing' state" },
      { "type": "text", "expected": "failed", "description": "Failed source ends in 'failed' state" },
      { "type": "text", "expected": "success", "description": "Successful source ends in 'success' state" },
      { "type": "boolean", "expected": false, "description": "isSyncing is false after sync completes" }
    ]
  },
  {
    "name": "IPC Security — Input Validation Layer",
    "methods": ["negative", "boundary", "exception"],
    "description": "Security validation at the electron-main IPC layer: SQL injection by feed URL ('; DROP TABLE post_info; --') → XSS by folder name (<script>alert('xss')</script>) → oversized URL (2000+ chars) → empty string folder name → whitespace-only folder name → invalid protocol (ftp://) → control characters in folder name (null byte) → article content exceeding 10MB size limit → oversize query (5000+ chars). All must be caught by IPC validators before reaching DB or service layer. Tests that error responses do NOT leak stack traces.",
    "testFilePath": "test/e2e/ipc-security.test.ts",
    "fixtures": {
      "attackVectors": {
        "sqlInjectionUrl": "'; DROP TABLE post_info; --",
        "xssFolderName": "<script>alert('xss')</script>",
        "oversizedUrl": "https://example.",
        "nullByteFolder": "test\u0000folder",
        "invalidProtocol": "ftp://invalid-protocol.example/feed.xml",
        "emptyUrl": "",
        "whitespaceUrl": "   \t\n  ",
        "oversizedContentSizeMb": 11
      }
    },
    "assertions": [
      { "type": "text", "expected": "INVALID_PARAM", "description": "SQL injection URL throws INVALID_PARAM" },
      { "type": "text", "expected": "INVALID_PARAM", "description": "XSS folder name throws INVALID_PARAM" },
      { "type": "text", "expected": "INVALID_PARAM", "description": "Oversized URL (>4096 chars) throws INVALID_PARAM" },
      { "type": "text", "expected": "INVALID_PARAM", "description": "Null byte in folder name throws INVALID_PARAM" },
      { "type": "text", "expected": "INVALID_PARAM", "description": "Invalid protocol (ftp) throws INVALID_PARAM" },
      { "type": "text", "expected": "INVALID_PARAM", "description": "Empty URL throws INVALID_PARAM" },
      { "type": "text", "expected": "INVALID_PARAM", "description": "Whitespace-only URL throws INVALID_PARAM" },
      { "type": "text", "expected": "INVALID_PARAM", "description": "Oversized article content throws INVALID_PARAM" },
      { "type": "boolean", "expected": true, "description": "Error messages do NOT contain 'Error:'' or stack traces" },
      { "type": "count", "expected": 500, "description": "MAX_ARTICLES_PER_PAGE constraint enforces at most 500 results" }
    ]
  },
