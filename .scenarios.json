  {
    "name": "Favorite/Unfavorite Toggle and Bulk Clear",
    "methods": ["state_transition", "boundary", "exception", "positive"],
    "description": "Favorite state machine through favoriteStore: toggle favorite on normal post (false→true→false) → verify store.favoriteCount and favoritePosts length → toggle favorite on boundary case titles (500-char title, emoji title, CJK title, HTML-escaped title) → clearAllFavorites → verify empty state. Tests idempotency: calling toggleFavorite twice on same post returns to original state without errors.",
    "testFilePath": "test/e2e/favorites.test.ts",
    "fixtures": {
      "posts": [
        { "title": "Understanding Quarks", "guid": "guid-quarks", "link": "https://science.example/quarks", "author": "Dr. Particle", "updateTime": "2024-06-10 08:00:00", "read": false, "desc": "Deep dive into particle physics...", "rssId": "feed-sci" },
        { "title": "日本語のタイトル — 测试文章标题 — 한국어 제목", "guid": "guid-cjk", "link": "https://example.com/cjk", "author": "多语言作者", "updateTime": "2024-06-11 12:30:00", "read": true, "desc": "多语言内容测试...", "rssId": "feed-test" },
        { "title": "🔥🚀 Latest News — Breaking! 📰✨", "guid": "guid-emoji", "link": "https://example.com/emoji-news", "author": "News Bot", "updateTime": "2024-06-12 16:45:00", "read": false, "desc": "Emoji-heavy title test...", "rssId": "feed-test" },
        { "title": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "guid": "guid-long-title", "link": "https://example.com/very-long-title", "author": "Long Author", "updateTime": "2024-06-13 07:00:00", "read": false, "desc": "Article with very long title...", "rssId": "feed-test" },
        { "title": "<script>alert('xss')</script>", "guid": "guid-xss", "link": "https://example.com/xss-test", "author": "Hacker", "updateTime": "2024-06-14 10:00:00", "read": false, "desc": "HTML entity escaped title...", "rssId": "feed-test" }
      ]
    },
    "assertions": [
      { "type": "count", "expected": 0, "description": "favoritePosts initially empty" },
      { "type": "boolean", "expected": true, "description": "toggleFavorite returns favorited=true for un-favorited post" },
      { "type": "count", "expected": 1, "description": "After first favorite, favoritePosts length is 1" },
      { "type": "count", "expected": 1, "description": "favoriteCount increments to 1" },
      { "type": "boolean", "expected": false, "description": "toggleFavorite same post again returns favorited=false" },
      { "type": "count", "expected": 0, "description": "After unfavorite, favoritePosts length back to 0" },
      { "type": "count", "expected": 3, "description": "Favorite 3 boundary posts, favoritePosts length is 3" },
      { "type": "text", "expected": "🔥🚀 Latest News — Breaking! 📰✨", "description": "Emoji title preserved in favorite list" },
      { "type": "text", "expected": "日本語のタイトル — 测试文章标题 — 한국어 제목", "description": "CJK title preserved in favorite list" },
      { "type": "count", "expected": 0, "description": "After clearAllFavorites, favoritePosts is empty" }
    ]
  },
  {
