  {
    "name": "Error Recovery — Network Failure, Parse Failure, Retry",
    "methods": ["exception", "state_transition", "boundary", "negative"],
    "description": "Error recovery flow across multiple failure modes: feed add fails with NETWORK_TIMEOUT → verify store.error='NETWORK_TIMEOUT' → retry with valid URL → verify store.error is null → feed fetch returns malformed XML → verify nothing crashes, store shows empty posts gracefully → add feed then remove it while sync is in progress → verify removal completes without deadlock → rapid-fire 10 IPC calls in sequence → verify no data corruption (each call returns expected results) → toggle read status on non-existent post GUID → verify error handling (not silent) → toggle favorite on non-existent post → verify error.",
    "testFilePath": "test/e2e/error-recovery.test.ts",
    "fixtures": {
      "feeds": [
        { "id": "feed-slow", "title": "Slow Feed", "feedUrl": "https://slow.example/rss.xml", "htmlUrl": "https://slow.example", "unread": 0, "avatar": "" },
        { "id": "feed-fast", "title": "Fast Feed", "feedUrl": "https://fast.example/rss.xml", "htmlUrl": "https://fast.example", "unread": 5, "avatar": "" }
      ],
      "failureModes": {
        "networkTimeout": "NETWORK_TIMEOUT: Feed fetch timed out",
        "parseError": "PARSE_ERROR: Malformed XML at line 42",
        "dbError": "DB_ERROR: SQLITE_BUSY: database is locked",
        "nonExistentGuid": "guid-does-not-exist-999"
      },
      "malformedPostResult": []
    },
    "assertions": [
      { "type": "text", "expected": "NETWORK_TIMEOUT", "description": "Feeds subscription with timeout error stores NETWORK_TIMEOUT" },
      { "type": "boolean", "expected": true, "description": "store.error is not null after network failure" },
      { "type": "boolean", "expected": false, "description": "isLoading resets to false after failure (no stuck loading)" },
      { "type": "text", "expected": "Fast Feed", "description": "Retry subscription succeeds, feed title is correct" },
      { "type": "boolean", "expected": false, "description": "store.error is null after retry succeeds" },
      { "type": "boolean", "expected": false, "description": "isLoading is false after retry" },
      { "type": "count", "expected": 0, "description": "Feed with parse failure returns empty post list (graceful)" },
      { "type": "text", "expected": "Article not found", "description": "toggleReadStatus on non-existent GUID throws 'Article not found'" },
      { "type": "boolean", "expected": true, "description": "rapid sequential IPC calls maintain correct call order and results" }
    ]
  }
]