      "feeds": [
        { "id": "feed-py", "title": "Python Blog", "feedUrl": "https://python.example/rss.xml", "htmlUrl": "https://python.example", "unread": 15, "avatar": "" },
        { "id": "feed-hn", "title": "Hacker News", "feedUrl": "https://hnrss.org/frontpage", "htmlUrl": "https://news.ycombinator.com", "unread": 42, "avatar": "" }
      ],
      "posts": [
        { "title": "Async Python Deep Dive", "guid": "post-001", "link": "https://python.example/async-deep-dive", "author": "Jane Dev", "updateTime": "2024-06-15 14:30:00", "read": false, "desc": "A comprehensive guide to asyncio patterns...", "rssId": "feed-py" },
        { "title": "PEP 723 Update", "guid": "post-002", "link": "https://python.example/pep-723", "author": "Guido Fan", "updateTime": "2024-06-14 09:00:00", "read": false, "desc": "New packaging standards...", "rssId": "feed-py" }
      ],
      "folders": [
        { "folderName": "Tech", "data": [], "children": [] }
      ],
      "edgeCases": {
        "dupFeedUrl": "https://python.example/rss.xml",
        "invalidUrl": "ftp://bad.example/feed.xml"
      }
    },
    "assertions": [
      { "type": "count", "expected": 1, "description": "After addFeed, rssFolderList[0].data has 1 feed" },
      { "type": "text", "expected": "Python Blog", "description": "Feed title matches after subscription" },
      { "type": "count", "expected": 2, "description": "queryPostIndexByRssId returns exactly 2 posts" },
      { "type": "text", "expected": "Async Python Deep Dive", "description": "Post title matches expected content" },
      { "type": "boolean", "expected": false, "description": "Post.read is false before toggleReadStatus" },
      { "type": "boolean", "expected": true, "description": "After toggleReadStatus, post.read is true" },
      { "type": "text", "expected": "Feed already exists", "description": "Duplicate subscription throws 'Feed already exists'" },
      { "type": "count", "expected": 0, "description": "After removeFeed, store.rssFolderList is empty" },
      { "type": "boolean", "expected": true, "description": "isLoading resets to false after removeFeed" },
      { "type": "text", "expected": "INVALID_PARAM", "description": "Feed URL with invalid protocol throws INVALID_PARAM" }
    ]
  },
  {
