[
  {
    "name": "Feed Subscription Lifecycle — Add → Read → Remove",
    "methods": ["positive", "state_transition", "boundary", "exception"],
    "description": "Complete feed lifecycle: subscribe to a feed with valid URL → verify store reflects new feed → fetch and count posts → read article content by GUID → toggle read status (false→true) → attempt duplicate subscription (must reject) → unsubscribe and verify store cleanup (empty state). Covers all state transitions across the feed lifecycle via mocked IPC.",
